# Базовый адрес сайта. Переезд на домен заказчика = смена этой переменной.
APP_URL=https://med.neeklo.ru
# false на стейдже: noindex + robots Disallow
INDEXING_ENABLED=false
# БД: в docker compose DATABASE_URL собирается из POSTGRES_PASSWORD автоматически
POSTGRES_PASSWORD=change-me
# для локального запуска без Docker:
# DATABASE_URL=postgres://medform:medform@localhost:5432/medform
# SEED_CATALOG=false отключает сиды временного каталога
SEED_CATALOG=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_BOOTSTRAP_EMAIL=
YM_COUNTER_ID=
PAYMENTS_PROVIDER=none
DELIVERY_PROVIDER=none
# PWA: off снимает service worker
NEXT_PUBLIC_SW=on
